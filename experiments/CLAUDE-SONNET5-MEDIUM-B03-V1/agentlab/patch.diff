+  align-items: center;
+  gap: var(--space-1);
+  padding: var(--space-3) var(--space-6);
+  border-radius: var(--radius-md);
+  border: 1px solid var(--border-strong);
+  background: var(--bg-card);
+  cursor: pointer;
+  transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
+}
+
+.day-cycle__option:hover {
+  border-color: var(--amber-400);
+  transform: translateY(-2px);
+}
+
+.day-cycle__option-time {
+  font-size: 0.75rem;
+  color: var(--text-faint);
+}
+
+.day-cycle__option-label {
+  font-weight: 650;
+}
+
+.day-cycle__option.is-active {
+  border-color: var(--amber-400);
+  background: linear-gradient(160deg, rgba(255, 159, 77, 0.16), rgba(139, 111, 240, 0.12));
+  box-shadow: 0 0 0 1px rgba(255, 159, 77, 0.35);
+}
+
+.day-cycle__display {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: var(--space-12);
+  align-items: center;
+  max-width: 1040px;
+  margin: 0 auto;
+}
+
+.day-cycle__stage {
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-6);
+  transition: box-shadow var(--transition-slow);
+  box-shadow: 0 0 60px -20px var(--stage-glow, transparent);
+}
+
+.day-cycle__stage-art {
+  width: 100%;
+}
+
+.day-cycle__meter {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  margin-top: var(--space-4);
+}
+
+.day-cycle__meter-row {
+  display: grid;
+  grid-template-columns: 3.5rem 1fr;
+  align-items: center;
+  gap: var(--space-3);
+  font-size: 0.8rem;
+  color: var(--text-faint);
+}
+
+.day-cycle__meter-track {
+  height: 6px;
+  border-radius: var(--radius-full);
+  background: var(--border);
+  overflow: hidden;
+}
+
+.day-cycle__meter-fill {
+  height: 100%;
+  border-radius: var(--radius-full);
+  transition: width var(--transition-slow);
+}
+
+.day-cycle__meter-fill--warm {
+  background: linear-gradient(90deg, var(--amber-500), var(--amber-400));
+}
+
+.day-cycle__meter-fill--cool {
+  background: linear-gradient(90deg, var(--violet-500), var(--violet-400));
+}
+
+.day-cycle__copy h3 {
+  margin-bottom: var(--space-3);
+}
+
+/* ---------------------------------------------------------------- features */
+
+.features__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: var(--space-6);
+  max-width: 1120px;
+  margin: 0 auto;
+}
+
+.feature-card {
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-6);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  transition: border-color var(--transition-fast), transform var(--transition-fast);
+}
+
+.feature-card:hover {
+  border-color: var(--border-strong);
+  transform: translateY(-3px);
+}
+
+.feature-card__icon {
+  width: 48px;
+  height: 48px;
+  display: grid;
+  place-items: center;
+  border-radius: var(--radius-md);
+  background: linear-gradient(160deg, rgba(255, 159, 77, 0.18), rgba(139, 111, 240, 0.14));
+  color: var(--amber-400);
+}
+
+.feature-card__icon svg {
+  width: 26px;
+  height: 26px;
+}
+
+/* ------------------------------------------------------------------- specs */
+
+.specs {
+  background: var(--bg-raised);
+  border-top: 1px solid var(--border);
+  border-bottom: 1px solid var(--border);
+}
+
+.specs__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+  gap: 1px;
+  background: var(--border);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  overflow: hidden;
+  max-width: 1120px;
+  margin: 0 auto;
+}
+
+.specs__item {
+  background: var(--bg-card);
+  padding: var(--space-6);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+.specs__item dt {
+  font-size: 0.75rem;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: var(--text-faint);
+}
+
+.specs__item dd {
+  margin: 0;
+  font-weight: 600;
+  font-size: 1.05rem;
+}
+
+/* ----------------------------------------------------------- social proof */
+
+.social-proof__stat {
+  max-width: 560px;
+  margin: 0 auto var(--space-12);
+  text-align: center;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+.social-proof__stat-value {
+  font-size: clamp(2.5rem, 4vw, 3.5rem);
+  font-weight: 750;
+  background: linear-gradient(100deg, var(--amber-400), var(--violet-400));
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+}
+
+.testimonials {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  gap: var(--space-6);
+  max-width: 1120px;
+  margin: 0 auto var(--space-12);
+}
+
+.testimonial-card {
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-6);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
+
+.testimonial-card__quote {
+  color: var(--text);
+  font-size: 1.02rem;
+}
+
+.testimonial-card__attribution {
+  display: flex;
+  flex-direction: column;
+  color: var(--text-faint);
+  font-size: 0.85rem;
+}
+
+.testimonial-card__name {
+  color: var(--text-muted);
+  font-weight: 600;
+}
+
+.press-quotes {
+  display: flex;
+  justify-content: center;
+  gap: var(--space-8);
+  flex-wrap: wrap;
+  max-width: 900px;
+  margin: 0 auto;
+}
+
+.press-quotes li {
+  text-align: center;
+  color: var(--text-faint);
+  font-size: 0.85rem;
+}
+
+.press-quotes p {
+  color: var(--text-muted);
+  font-style: italic;
+  margin-bottom: var(--space-1);
+}
+
+/* ---------------------------------------------------------------- pricing */
+
+.pricing__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: var(--space-6);
+  max-width: 1120px;
+  margin: 0 auto;
+  align-items: stretch;
+}
+
+.pricing-card {
+  position: relative;
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-8) var(--space-6) var(--space-6);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  transition: border-color var(--transition-fast), transform var(--transition-fast);
+}
+
+.pricing-card:hover {
+  transform: translateY(-3px);
+}
+
+.pricing-card.is-recommended {
+  border-color: var(--amber-400);
+  background: linear-gradient(180deg, rgba(255, 159, 77, 0.1), var(--bg-card) 40%);
+  box-shadow: var(--shadow-lg);
+}
+
+.pricing-card__badge {
+  position: absolute;
+  top: -14px;
+  left: var(--space-6);
+  background: linear-gradient(120deg, var(--amber-400), var(--amber-600));
+  color: #1a1206;
+  font-size: 0.72rem;
+  font-weight: 700;
+  padding: 0.3rem 0.75rem;
+  border-radius: var(--radius-full);
+}
+
+.pricing-card__description {
+  min-height: 3rem;
+}
+
+.pricing-card__price {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-2);
+  flex-wrap: wrap;
+}
+
+.pricing-card__price-value {
+  font-size: 1.6rem;
+  font-weight: 700;
+  color: var(--text);
+}
+
+.pricing-card__price-period {
+  color: var(--text-faint);
+  font-size: 0.85rem;
+}
+
+.pricing-card__features {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+  flex: 1;
+}
+
+.pricing-card__features li {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-size: 0.9rem;
+  color: var(--text-muted);
+}
+
+.pricing-card__check {
+  width: 18px;
+  height: 18px;
+  color: var(--success);
+  flex-shrink: 0;
+}
+
+.pricing-card .btn {
+  margin-top: auto;
+}
+
+/* ------------------------------------------------------------------- faq */
+
+.faq__list {
+  max-width: 760px;
+  margin: 0 auto;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+
+.faq-item {
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  overflow: hidden;
+}
+
+.faq-item__heading {
+  margin: 0;
+}
+
+.faq-item__question {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-4);
+  background: transparent;
+  border: none;
+  text-align: left;
+  padding: var(--space-4) var(--space-6);
+  font-weight: 600;
+  font-size: 1rem;
+  cursor: pointer;
+  color: var(--text);
+}
+
+.faq-item__question:hover {
+  color: var(--amber-400);
+}
+
+.faq-item__chevron {
+  width: 20px;
+  height: 20px;
+  flex-shrink: 0;
+  color: var(--text-faint);
+  transition: transform var(--transition-base);
+}
+
+.faq-item.is-open .faq-item__chevron {
+  transform: rotate(180deg);
+  color: var(--amber-400);
+}
+
+.faq-item__answer {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows var(--transition-base);
+}
+
+.faq-item.is-open .faq-item__answer {
+  grid-template-rows: 1fr;
+}
+
+.faq-item__answer-inner {
+  overflow: hidden;
+}
+
+.faq-item__answer-inner p {
+  padding: 0 var(--space-6) var(--space-5);
+}
+
+/* ---------------------------------------------------------------- footer */
+
+.site-footer {
+  border-top: 1px solid var(--border);
+  padding: var(--space-16) max(var(--space-6), calc(50% - 560px)) var(--space-8);
+}
+
+.site-footer__inner {
+  display: grid;
+  grid-template-columns: minmax(0, 1.3fr) minmax(0, 2fr);
+  gap: var(--space-12);
+  padding-bottom: var(--space-12);
+}
+
+.site-footer__brand {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  max-width: 36ch;
+}
+
+.site-footer__brand p {
+  font-size: 0.9rem;
+}
+
+.site-footer__nav {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-6);
+}
+
+.site-footer__group h3 {
+  font-size: 0.8rem;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: var(--text-faint);
+  margin-bottom: var(--space-3);
+}
+
+.site-footer__group ul {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+.site-footer__group a {
+  text-decoration: none;
+  color: var(--text-muted);
+  font-size: 0.9rem;
+  transition: color var(--transition-fast);
+}
+
+.site-footer__group a:hover {
+  color: var(--text);
+}
+
+.site-footer__legal {
+  border-top: 1px solid var(--border);
+  padding-top: var(--space-6);
+  color: var(--text-faint);
+  font-size: 0.8rem;
+}
+
+/* -------------------------------------------------------------- reduced motion */
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.001ms !important;
+  }
+}
+
+/* ------------------------------------------------------------------ tablet */
+
+@media (max-width: 960px) {
+  .hero {
+    grid-template-columns: 1fr;
+    padding-top: var(--space-12);
+  }
+
+  .hero__visual {
+    order: -1;
+  }
+
+  .lamp-illustration {
+    max-width: 320px;
+  }
+
+  .day-cycle__display {
+    grid-template-columns: 1fr;
+  }
+
+  .site-footer__inner {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* ------------------------------------------------------------------ mobile */
+
+@media (max-width: 640px) {
+  .section {
+    padding: var(--space-16) var(--space-4);
+  }
+
+  .site-header__inner {
+    flex-wrap: wrap;
+    gap: var(--space-3);
+  }
+
+  .site-nav ul {
+    gap: var(--space-4);
+    row-gap: var(--space-2);
+  }
+
+  .hero__actions {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .hero__stats {
+    flex-wrap: wrap;
+    gap: var(--space-4) var(--space-8);
+  }
+
+  .day-cycle__options {
+    gap: var(--space-2);
+  }
+
+  .day-cycle__option {
+    padding: var(--space-2) var(--space-4);
+  }
+
+  .site-footer__nav {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .pricing-card .btn {
+    width: 100%;
+  }
 }
