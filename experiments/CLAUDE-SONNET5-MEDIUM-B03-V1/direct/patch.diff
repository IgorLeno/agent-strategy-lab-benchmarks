+  --border-strong: rgba(255, 255, 255, 0.16);
+
+  --text: #f6f3ec;
+  --text-muted: #b3aec0;
+  --text-dim: #786f8c;
+
+  --amber-400: #ffcf8a;
+  --amber-500: #ffb168;
+  --amber-600: #ff9a4d;
