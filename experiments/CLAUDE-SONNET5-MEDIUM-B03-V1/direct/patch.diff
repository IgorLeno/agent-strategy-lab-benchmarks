+  background: var(--surface);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.2rem;
+  min-width: 130px;
+  transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
+}
+
+.day-cycle__option:hover {
+  border-color: var(--border-strong);
+  transform: translateY(-1px);
+}
+
+.day-cycle__option:focus-visible {
+  outline: 2px solid var(--amber-400);
+  outline-offset: 2px;
+}
+
+.day-cycle__option[data-active='true'] {
+  background: var(--gradient-panel);
+  border-color: var(--amber-500);
+}
+
+.day-cycle__option-label {
+  font-weight: 600;
+}
+
+.day-cycle__option-time {
+  font-size: 0.8rem;
+  color: var(--text-dim);
+}
+
+.day-cycle__display {
+  display: grid;
+  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
+  gap: var(--space-8);
+  align-items: center;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-7);
+}
+
+.day-cycle__stage {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  border-radius: var(--radius-md);
+  padding: var(--space-6);
+  background: radial-gradient(70% 70% at 50% 30%, color-mix(in srgb, var(--stage-glow) 22%, transparent), transparent);
+  transition: background 0.4s ease;
+}
+
+.day-cycle__lamp {
+  width: min(100%, 220px);
+  transition: filter 0.4s ease;
+}
+
+.day-cycle__kelvin {
+  margin-top: var(--space-4);
+  font-weight: 700;
+  font-size: 1.05rem;
+  letter-spacing: 0.03em;
+  color: var(--stage-glow);
+}
+
+.day-cycle__text p {
+  margin-top: var(--space-3);
+  color: var(--text-muted);
+}
+
+/* --------------------------------------------------------------- features */
+.features__grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-5);
+}
+
+.feature-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: var(--space-6);
+  transition: border-color 0.2s ease, transform 0.2s ease;
+}
+
+.feature-card:hover {
+  border-color: var(--border-strong);
+  transform: translateY(-2px);
+}
+
+.feature-card__icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 44px;
+  height: 44px;
+  border-radius: var(--radius-sm);
+  background: var(--gradient-panel);
+  color: var(--amber-400);
+  margin-bottom: var(--space-4);
+}
+
+.feature-card__icon svg {
+  width: 24px;
+  height: 24px;
+}
+
+.feature-card h3 {
+  margin-bottom: var(--space-2);
+}
+
+.feature-card p {
+  color: var(--text-muted);
+  font-size: 0.95rem;
+}
+
+/* ----------------------------------------------------------------- specs */
+.specs__grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-6);
+}
+
+.specs__group {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: var(--space-6);
+}
+
+.specs__group h3 {
+  margin-bottom: var(--space-4);
+  color: var(--amber-400);
+  font-family: var(--font-body);
+  font-size: 0.85rem;
+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  font-weight: 700;
+}
+
+.specs__row {
+  display: flex;
+  justify-content: space-between;
+  gap: var(--space-4);
+  padding: var(--space-3) 0;
+  border-top: 1px solid var(--border);
+}
+
+.specs__row:first-of-type {
+  border-top: none;
+}
+
+.specs__row dt {
+  color: var(--text-muted);
+  font-size: 0.92rem;
+}
+
+.specs__row dd {
+  font-weight: 600;
+  text-align: right;
+}
+
+/* ---------------------------------------------------------- social proof */
+.social-proof__stat {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  text-align: center;
+  margin-bottom: var(--space-8);
+}
+
+.social-proof__stat-value {
+  font-family: var(--font-display);
+  font-size: clamp(3rem, 2.4rem + 2.6vw, 5rem);
+  background: var(--gradient-amber);
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+  line-height: 1;
+}
+
+.social-proof__stat-label {
+  margin-top: var(--space-3);
+  max-width: 32ch;
+  color: var(--text-muted);
+}
+
+.social-proof__grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-5);
+  margin-bottom: var(--space-7);
+}
+
+.testimonial-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: var(--space-6);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-5);
+}
+
+.testimonial-card__quote {
+  font-size: 1.02rem;
+  line-height: 1.55;
+}
+
+.testimonial-card__attribution {
+  display: flex;
+  flex-direction: column;
+  margin-top: auto;
+}
+
+.testimonial-card__name {
+  font-weight: 600;
+}
+
+.testimonial-card__role {
+  font-size: 0.85rem;
+  color: var(--text-dim);
+}
+
+.press-quote {
+  text-align: center;
+  max-width: 700px;
+  margin: 0 auto;
+  padding: var(--space-6) 0 0;
+  border-top: 1px solid var(--border);
+}
+
+.press-quote p {
+  font-family: var(--font-display);
+  font-size: 1.35rem;
+  line-height: 1.4;
+}
+
+.press-quote cite {
+  display: block;
+  margin-top: var(--space-3);
+  font-style: normal;
+  color: var(--text-dim);
+  font-size: 0.9rem;
+}
+
+/* --------------------------------------------------------------- pricing */
+.pricing__grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-5);
+  align-items: stretch;
+}
+
+.pricing-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-6);
+}
+
+.pricing-card--recommended {
+  border-color: var(--amber-500);
+  background: var(--gradient-panel), var(--surface);
+  box-shadow: var(--shadow-md);
+  transform: translateY(-8px);
+}
+
+.pricing-card__badge {
+  position: absolute;
+  top: -14px;
+  left: var(--space-6);
+  background: var(--gradient-amber);
+  color: #201305;
+  font-size: 0.75rem;
+  font-weight: 700;
+  padding: 0.3rem 0.8rem;
+  border-radius: var(--radius-pill);
+}
+
+.pricing-card__price {
+  display: flex;
+  align-items: baseline;
+  gap: var(--space-2);
+  margin: var(--space-4) 0 var(--space-3);
+}
+
+.pricing-card__amount {
+  font-family: var(--font-display);
+  font-size: 2.4rem;
+  font-weight: 700;
+}
+
+.pricing-card__billing {
+  color: var(--text-dim);
+  font-size: 0.85rem;
+}
+
+.pricing-card__description {
+  color: var(--text-muted);
+  font-size: 0.95rem;
+}
+
+.pricing-card__features {
+  margin: var(--space-5) 0 var(--space-6);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+
+.pricing-card__features li {
+  padding-left: 1.6rem;
+  position: relative;
+  font-size: 0.92rem;
+  color: var(--text-muted);
+}
+
+.pricing-card__features li::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  top: 0.4em;
+  width: 10px;
+  height: 10px;
+  border-radius: 3px;
+  background: var(--gradient-amber);
+}
+
+.pricing-card__cta {
+  margin-top: auto;
+  width: 100%;
+}
+
+/* ------------------------------------------------------------------ faq */
+.faq__list {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  max-width: 760px;
+  margin: 0 auto;
+}
+
+.faq-item {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  overflow: hidden;
+}
+
+.faq-item__heading {
+  font-family: var(--font-body);
+  font-size: 1rem;
+  font-weight: 600;
+}
+
+.faq-item__question {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-4);
+  padding: var(--space-5) var(--space-6);
+  text-align: left;
+  transition: color 0.15s ease;
+}
+
+.faq-item__question:hover {
+  color: var(--amber-400);
+}
+
+.faq-item__question:focus-visible {
+  outline: 2px solid var(--amber-400);
+  outline-offset: -3px;
+}
+
+.faq-item__icon {
+  flex-shrink: 0;
+  width: 28px;
+  height: 28px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 50%;
+  background: var(--surface-alt);
+  font-size: 1.1rem;
+  color: var(--amber-400);
+}
+
+.faq-item__answer {
+  padding: 0 var(--space-6) var(--space-5);
+  color: var(--text-muted);
+}
+
+/* --------------------------------------------------------------- footer */
+.site-footer {
+  border-top: 1px solid var(--border);
+  padding: var(--space-8) var(--space-5) var(--space-6);
+  background: var(--bg-elevated);
+}
+
+.site-footer__inner {
+  max-width: var(--container);
+  margin: 0 auto;
+  display: grid;
+  grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 1fr));
+  gap: var(--space-7);
+}
+
+.site-footer__brand p {
+  margin-top: var(--space-4);
+  color: var(--text-muted);
+  font-size: 0.9rem;
+  max-width: 32ch;
+}
+
+.site-footer__nav {
+  display: contents;
+}
+
+.site-footer__group h3 {
+  font-family: var(--font-body);
+  font-size: 0.8rem;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: var(--text-dim);
+  margin-bottom: var(--space-4);
+}
+
+.site-footer__group ul {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+
+.site-footer__group a {
+  color: var(--text-muted);
+  font-size: 0.92rem;
+  transition: color 0.15s ease;
+}
+
+.site-footer__group a:hover {
+  color: var(--text);
+}
+
+.site-footer__legal {
+  max-width: var(--container);
+  margin: var(--space-7) auto 0;
+  padding-top: var(--space-5);
+  border-top: 1px solid var(--border);
+  color: var(--text-dim);
+  font-size: 0.82rem;
+}
+
+/* ----------------------------------------------------------- responsive */
+@media (max-width: 900px) {
+  .hero__inner {
+    grid-template-columns: 1fr;
+    text-align: center;
+  }
+
+  .hero__lead {
+    margin-left: auto;
+    margin-right: auto;
+  }
+
+  .hero__actions {
+    justify-content: center;
+  }
+
+  .hero__stats {
+    justify-content: center;
+    flex-wrap: wrap;
+    text-align: left;
+  }
+
+  .hero__visual {
+    order: -1;
+  }
+
+  .day-cycle__display {
+    grid-template-columns: 1fr;
+    text-align: center;
+  }
+
+  .features__grid,
+  .specs__grid,
+  .social-proof__grid,
+  .pricing__grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .site-footer__inner {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .pricing-card--recommended {
+    transform: none;
+  }
+}
+
+@media (max-width: 640px) {
+  .site-header__inner {
+    gap: var(--space-3);
+  }
+
+  .site-nav ul {
+    gap: var(--space-4);
+  }
+
+  section {
+    padding: var(--space-8) var(--space-4);
+  }
+
+  .features__grid,
+  .specs__grid,
+  .social-proof__grid,
+  .pricing__grid {
+    grid-template-columns: 1fr;
+  }
+
+  .site-footer__inner {
+    grid-template-columns: 1fr;
+    gap: var(--space-6);
+  }
+
+  .hero__stats {
+    gap: var(--space-5);
+  }
+
+  .day-cycle__options {
+    gap: var(--space-2);
+  }
+
+  .day-cycle__option {
+    min-width: 0;
+    flex: 1 1 calc(50% - var(--space-2));
+    padding: var(--space-3);
+  }
+}
+
+@media (max-width: 460px) {
+  .site-nav {
+    display: none;
+  }
+
+  .site-header__inner {
+    justify-content: space-between;
+  }
 }
