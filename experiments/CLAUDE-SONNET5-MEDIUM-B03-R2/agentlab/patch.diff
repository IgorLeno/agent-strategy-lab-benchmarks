+  position: relative;
+  border-radius: var(--radius-lg);
+  background: radial-gradient(circle at 50% 30%, #201d3a, #0d0e17 70%);
+  border: 1px solid var(--border);
+  min-height: 320px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden;
+}
+
+.hero__lamp-svg {
+  width: 100%;
+  height: auto;
+  max-width: 380px;
+}
+
+/* ------------------------------------------------------------- day cycle */
+
+.day-cycle__layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: 2.5rem;
+  align-items: stretch;
+}
+
+.day-cycle__stage {
+  border-radius: var(--radius-lg);
+  padding: 2rem;
+  min-height: 320px;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  position: relative;
+  box-shadow: var(--shadow-soft);
+  transition: background 0.6s ease;
+}
+
+.day-cycle__stage-svg {
+  width: 100%;
+  max-width: 300px;
+  margin: 0 auto;
+}
+
+.day-cycle__sun {
+  transition: cy 0.6s ease, fill 0.6s ease;
+}
+
+.day-cycle__stage-meta {
+  display: flex;
+  justify-content: space-between;
+  font-weight: 700;
+  font-size: 1.05rem;
+}
+
+.day-cycle__stage-meta span {
+  background: rgba(13, 14, 23, 0.45);
+  color: #fff;
+  padding: 0.3rem 0.75rem;
+  border-radius: 999px;
+  backdrop-filter: blur(4px);
+}
+
+.day-cycle__panel {
+  display: flex;
+  flex-direction: column;
+  gap: 1.5rem;
+  justify-content: center;
+}
+
+.day-cycle__options {
+  display: flex;
+  gap: 0.75rem;
+  flex-wrap: wrap;
+}
+
+.day-cycle__option {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: 0.85rem 1.15rem;
+  color: var(--text-muted);
+  cursor: pointer;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 0.2rem;
+  transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease, transform 0.15s ease;
+  min-width: 6.5rem;
+}
+
+.day-cycle__option:hover {
+  border-color: var(--accent);
+  color: var(--text);
+  transform: translateY(-2px);
+}
+
+.day-cycle__option[aria-pressed='true'] {
+  background: linear-gradient(135deg, var(--accent-strong), var(--accent));
+  color: #1a1408;
+  border-color: transparent;
+}
+
+.day-cycle__option-label {
+  font-weight: 700;
+  font-size: 0.95rem;
+}
+
+.day-cycle__option-time {
+  font-size: 0.78rem;
+  opacity: 0.8;
+}
+
+.day-cycle__panel h3 {
+  font-size: 1.4rem;
+}
+
+.day-cycle__panel p {
+  color: var(--text-muted);
+}
+
+/* -------------------------------------------------------------- features */
+
+.features__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+  gap: 1.5rem;
+}
+
+.feature-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: 1.75rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.85rem;
+  box-shadow: var(--shadow-card);
+  transition: border-color 0.2s ease, transform 0.2s ease;
+}
+
+.feature-card:hover {
+  border-color: var(--accent);
+  transform: translateY(-3px);
+}
+
+.feature-card__icon {
+  width: 3rem;
+  height: 3rem;
+  border-radius: var(--radius-sm);
+  background: linear-gradient(135deg, rgba(255, 184, 119, 0.18), rgba(138, 92, 255, 0.18));
+  color: var(--accent);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.feature-card__icon svg {
+  width: 1.6rem;
+  height: 1.6rem;
+}
+
+.feature-card h3 {
+  font-size: 1.1rem;
+}
+
+.feature-card p {
+  color: var(--text-muted);
+  font-size: 0.95rem;
+}
+
+/* ----------------------------------------------------------------- specs */
+
+.specs__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 0;
+  border-top: 1px solid var(--border);
+}
+
+.specs__row {
+  display: flex;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 1.1rem 0.25rem;
+  border-bottom: 1px solid var(--border);
+}
+
+.specs__row dt {
+  color: var(--text-dim);
+  font-size: 0.9rem;
+}
+
+.specs__row dd {
+  margin: 0;
+  font-weight: 600;
+  text-align: right;
+}
+
+/* ---------------------------------------------------------- social proof */
+
+.social-proof__stat {
+  display: flex;
+  align-items: baseline;
+  gap: 1rem;
+  flex-wrap: wrap;
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: 1.75rem;
+  margin-bottom: 2.5rem;
+}
+
+.social-proof__stat-value {
+  font-size: 3rem;
+  font-weight: 800;
+  color: var(--accent);
+}
+
+.social-proof__stat-label {
+  color: var(--text-muted);
+  max-width: 42ch;
+}
+
+.testimonials__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  gap: 1.5rem;
+  margin-bottom: 2rem;
+}
+
+.testimonial-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: 1.75rem;
+  display: flex;
+  flex-direction: column;
+  gap: 1.25rem;
+  box-shadow: var(--shadow-card);
+}
+
+.testimonial-card__quote {
+  color: var(--text);
+  font-size: 1rem;
+}
+
+.testimonial-card__author {
+  display: flex;
+  flex-direction: column;
+  gap: 0.15rem;
+  font-size: 0.85rem;
+}
+
+.testimonial-card__name {
+  font-weight: 700;
+}
+
+.testimonial-card__role {
+  color: var(--text-dim);
+}
+
+.press__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  gap: 1.25rem;
+}
+
+.press-card {
+  border: 1px dashed var(--border);
+  border-radius: var(--radius-md);
+  padding: 1.25rem 1.5rem;
+  color: var(--text-muted);
+  font-style: italic;
+  display: flex;
+  flex-direction: column;
+  gap: 0.5rem;
+}
+
+.press-card span {
+  font-style: normal;
+  font-weight: 700;
+  color: var(--text-dim);
+  text-transform: uppercase;
+  font-size: 0.75rem;
+  letter-spacing: 0.06em;
+}
+
+/* ------------------------------------------------------------------ pricing */
+
+.pricing__grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 1.5rem;
+  align-items: stretch;
+}
+
+.pricing-card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: 2rem;
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  position: relative;
+  box-shadow: var(--shadow-card);
+}
+
+.pricing-card--highlighted {
+  border-color: var(--accent);
+  background: linear-gradient(180deg, rgba(255, 184, 119, 0.08), var(--surface) 40%);
+  box-shadow: 0 20px 45px -20px rgba(255, 157, 77, 0.45);
+}
+
+.pricing-card__badge {
+  position: absolute;
+  top: -0.8rem;
+  left: 2rem;
+  background: linear-gradient(135deg, var(--accent-strong), var(--accent));
+  color: #1a1408;
+  font-size: 0.75rem;
+  font-weight: 700;
+  padding: 0.3rem 0.9rem;
+  border-radius: 999px;
+}
+
+.pricing-card__price {
+  font-size: 2rem;
+  font-weight: 800;
+  display: flex;
+  flex-direction: column;
+  gap: 0.2rem;
+}
+
+.pricing-card__cadence {
+  font-size: 0.8rem;
+  font-weight: 500;
+  color: var(--text-dim);
+}
+
+.pricing-card__description {
+  color: var(--text-muted);
+  font-size: 0.95rem;
+}
+
+.pricing-card__features {
+  display: flex;
+  flex-direction: column;
+  gap: 0.6rem;
+  flex: 1;
+}
+
+.pricing-card__features li {
+  padding-left: 1.4rem;
+  position: relative;
+  color: var(--text-muted);
+  font-size: 0.9rem;
+}
+
+.pricing-card__features li::before {
+  content: '';
+  position: absolute;
+  left: 0;
+  top: 0.45rem;
+  width: 0.6rem;
+  height: 0.6rem;
+  border-radius: 50%;
+  background: var(--success);
+}
+
+/* --------------------------------------------------------------------- faq */
+
+.faq__list {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+}
+
+.faq-item {
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--surface);
+  overflow: hidden;
+}
+
+.faq-item__heading {
+  margin: 0;
+}
+
+.faq-item__question {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+  background: transparent;
+  border: none;
+  color: var(--text);
+  font-size: 1rem;
+  font-weight: 600;
+  text-align: left;
+  padding: 1.2rem 1.5rem;
+  cursor: pointer;
+}
+
+.faq-item__question:hover {
+  color: var(--accent);
+}
+
+.faq-item__icon {
+  font-size: 1.3rem;
+  color: var(--accent);
+  flex-shrink: 0;
+}
+
+.faq-item__answer {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows 0.3s ease;
+}
+
+.faq-item__answer > p {
+  overflow: hidden;
+  padding: 0 1.5rem;
+  color: var(--text-muted);
+  min-height: 0;
+}
+
+.faq-item__answer--open {
+  grid-template-rows: 1fr;
+}
+
+.faq-item__answer--open > p {
+  padding: 0 1.5rem 1.4rem;
+}
+
+/* ----------------------------------------------------------------- footer */
+
+.site-footer {
+  border-top: 1px solid var(--border);
+  background: var(--surface);
+  margin-top: 3rem;
+}
+
+.site-footer__inner {
+  max-width: var(--max-width);
+  margin: 0 auto;
+  padding: 4rem 1.5rem 2.5rem;
+  display: grid;
+  grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
+  gap: 3rem;
+}
+
+.site-footer__brand {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+}
+
+.site-footer__brand p {
+  color: var(--text-muted);
+  font-size: 0.9rem;
+  max-width: 36ch;
+}
+
+.site-footer__groups {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1.5rem;
+}
+
+.site-footer__group-title {
+  font-size: 0.8rem;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--text-dim);
+  margin-bottom: 0.9rem;
+}
+
+.site-footer__groups ul {
+  display: flex;
+  flex-direction: column;
+  gap: 0.65rem;
+}
+
+.site-footer__groups a {
+  color: var(--text-muted);
+  font-size: 0.92rem;
+}
+
+.site-footer__groups a:hover {
+  color: var(--accent);
+}
+
+.site-footer__legal {
+  border-top: 1px solid var(--border);
+  padding: 1.5rem;
+  display: flex;
+  justify-content: space-between;
+  gap: 1rem;
+  flex-wrap: wrap;
+  max-width: var(--max-width);
+  margin: 0 auto;
+  color: var(--text-dim);
+  font-size: 0.82rem;
+}
+
+/* ------------------------------------------------------------- responsive */
+
+@media (max-width: 900px) {
+  .hero {
+    grid-template-columns: 1fr;
+    padding-top: 2.5rem;
+  }
+
+  .hero__visual {
+    order: -1;
+    min-height: 240px;
+  }
+
+  .day-cycle__layout {
+    grid-template-columns: 1fr;
+  }
+
+  .site-footer__inner {
+    grid-template-columns: 1fr;
+  }
+
+  .site-footer__groups {
+    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+  }
+}
+
+@media (max-width: 560px) {
+  .section {
+    padding: 3.5rem 1.25rem;
+  }
+
+  .hero__actions {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .hero__stats {
+    gap: 1.5rem;
+  }
+
+  .day-cycle__options {
+    justify-content: space-between;
+  }
+
+  .day-cycle__option {
+    flex: 1 1 40%;
+  }
+
+  .specs__row dd {
+    text-align: left;
+  }
+
+  .specs__row {
+    flex-direction: column;
+    gap: 0.2rem;
+  }
+
+  .site-header__cta {
+    display: none;
+  }
 }
