+.day-cycle__option[data-active='true'] {
+  border-color: var(--amber);
+  background: var(--amber-soft);
+  box-shadow: 0 0 0 1px rgba(255, 180, 84, 0.25);
+}
+
+.day-cycle__option-icon {
+  width: 24px;
+  height: 24px;
+  color: var(--amber);
+  flex-shrink: 0;
+}
+
+.day-cycle__option-label {
+  font-weight: 600;
+  flex: 1;
+}
+
+.day-cycle__option-time {
+  font-size: 0.82rem;
+  color: var(--text-faint);
+}
+
+.day-cycle__stage {
+  border-radius: var(--radius-lg);
+  border: 1px solid var(--border);
+  background: var(--bg-elevated);
+  min-height: 280px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  position: relative;
+  transition: background 0.3s ease;
+}
+
+.day-cycle__stage-svg {
+  width: 220px;
+  height: 220px;
+}
+
+.day-cycle__stage-readout {
+  position: absolute;
+  bottom: 20px;
+  left: 24px;
+  display: flex;
+  flex-direction: column;
+}
+
+.day-cycle__kelvin {
+  font-size: 1.3rem;
+  font-weight: 700;
+}
+
+.day-cycle__time {
+  font-size: 0.85rem;
+  color: var(--text-muted);
+}
+
+.day-cycle__copy h3 {
+  font-size: 1.4rem;
+  margin-bottom: 10px;
+}
+
+.day-cycle__copy p {
+  color: var(--text-muted);
+  max-width: 58ch;
+}
+
+/* --------------------------------------------------------------- features */
+
+.features__grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 24px;
+}
+
+.feature-card {
+  padding: 28px;
+  border-radius: var(--radius-md);
+  border: 1px solid var(--border);
+  background: var(--bg-elevated);
+  transition: border-color 0.15s ease, transform 0.15s ease;
+}
+
+.feature-card:hover {
+  border-color: var(--violet);
+  transform: translateY(-3px);
+}
+
+.feature-card__icon {
+  width: 44px;
+  height: 44px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: var(--radius-sm);
+  background: var(--violet-soft);
+  color: var(--violet);
+  margin-bottom: 18px;
+}
+
+.feature-card h3 {
+  font-size: 1.1rem;
+  margin-bottom: 8px;
+}
+
+.feature-card p {
+  color: var(--text-muted);
+  font-size: 0.94rem;
+}
+
+/* ------------------------------------------------------------------ specs */
+
+.specs__grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 0 48px;
+  padding: 32px;
+}
+
+.specs__row {
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 16px 0;
+  border-bottom: 1px solid var(--border-soft);
+}
+
+.specs__row dt {
+  color: var(--text-muted);
+  font-size: 0.92rem;
+}
+
+.specs__row dd {
+  font-weight: 600;
+  text-align: right;
+}
+
+/* ------------------------------------------------------------ socialproof */
+
+.social-proof__claim {
+  margin-top: 18px;
+  font-size: 1.15rem;
+  font-weight: 600;
+  color: var(--amber);
+}
+
+.social-proof__grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 20px;
+}
+
+.press-quote,
+.testimonial-card {
+  margin: 0;
+  padding: 28px;
+  border-radius: var(--radius-md);
+  border: 1px solid var(--border);
+  background: var(--bg-elevated);
+}
+
+.press-quote {
+  background: linear-gradient(135deg, var(--amber-soft), var(--bg-elevated));
+  border-color: rgba(255, 180, 84, 0.35);
+}
+
+.press-quote blockquote,
+.testimonial-card blockquote {
+  margin: 0 0 16px;
+  font-size: 1.08rem;
+  line-height: 1.55;
+}
+
+.press-quote figcaption {
+  font-weight: 700;
+  color: var(--amber);
+  font-size: 0.9rem;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+}
+
+.testimonial-card figcaption {
+  display: flex;
+  flex-direction: column;
+}
+
+.testimonial-card__name {
+  font-weight: 600;
+}
+
+.testimonial-card__role {
+  font-size: 0.85rem;
+  color: var(--text-faint);
+}
+
+/* ---------------------------------------------------------------- pricing */
+
+.pricing__grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 24px;
+  align-items: stretch;
+}
+
+.pricing-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  padding: 32px;
+  border-radius: var(--radius-lg);
+  border: 1px solid var(--border);
+  background: var(--bg-elevated);
+}
+
+.pricing-card--featured {
+  border-color: var(--amber);
+  background: linear-gradient(180deg, var(--amber-soft), var(--bg-elevated) 60%);
+  box-shadow: var(--shadow-glow);
+  transform: translateY(-8px);
+}
+
+.pricing-card__badge {
+  position: absolute;
+  top: -14px;
+  left: 32px;
+  background: var(--amber);
+  color: #1a1305;
+  font-size: 0.75rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  padding: 6px 14px;
+  border-radius: 999px;
+}
+
+.pricing-card h3 {
+  font-size: 1.3rem;
+  margin-bottom: 6px;
+}
+
+.pricing-card__description {
+  color: var(--text-muted);
+  font-size: 0.92rem;
+  margin-bottom: 22px;
+  min-height: 40px;
+}
+
+.pricing-card__price {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  margin-bottom: 24px;
+}
+
+.pricing-card__amount {
+  font-size: 2.4rem;
+  font-weight: 700;
+}
+
+.pricing-card__cadence {
+  color: var(--text-faint);
+  font-size: 0.85rem;
+}
+
+.pricing-card__features {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  margin-bottom: 30px;
+  flex: 1;
+}
+
+.pricing-card__features li {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  font-size: 0.92rem;
+  color: var(--text);
+}
+
+.pricing-card__check {
+  width: 18px;
+  height: 18px;
+  color: var(--amber);
+  flex-shrink: 0;
+  margin-top: 2px;
+}
+
+.pricing-card__cta {
+  width: 100%;
+}
+
+/* ------------------------------------------------------------------- faq */
+
+.faq__list {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  max-width: 760px;
+  margin: 0 auto;
+}
+
+.faq-item {
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--bg-elevated);
+  overflow: hidden;
+}
+
+.faq-item__heading {
+  margin: 0;
+}
+
+.faq-item__question {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 20px 24px;
+  font-size: 1rem;
+  font-weight: 600;
+  text-align: left;
+}
+
+.faq-item__question:hover {
+  color: var(--amber);
+}
+
+.faq-item__chevron {
+  width: 20px;
+  height: 20px;
+  flex-shrink: 0;
+  color: var(--text-faint);
+  transition: transform 0.2s ease;
+}
+
+.faq-item__chevron--open {
+  transform: rotate(180deg);
+  color: var(--amber);
+}
+
+.faq-item__panel {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows 0.25s ease;
+}
+
+.faq-item__panel--open {
+  grid-template-rows: 1fr;
+}
+
+.faq-item__panel > .faq-item__answer {
+  overflow: hidden;
+}
+
+.faq-item__answer {
+  min-height: 0;
+  color: var(--text-muted);
+  padding: 0 24px;
+  line-height: 1.6;
+}
+
+.faq-item__panel--open .faq-item__answer {
+  padding: 0 24px 22px;
+}
+
+/* --------------------------------------------------------------- footer */
+
+.site-footer {
+  border-top: 1px solid var(--border-soft);
+  background: var(--bg-elevated);
+}
+
+.site-footer__inner {
+  max-width: var(--content-width);
+  margin: 0 auto;
+  padding: 64px 24px 40px;
+  display: grid;
+  grid-template-columns: 1.2fr 2fr;
+  gap: 48px;
+}
+
+.site-footer__brand p {
+  margin-top: 16px;
+  color: var(--text-muted);
+  max-width: 34ch;
+  font-size: 0.92rem;
+}
+
+.site-footer__nav {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 24px;
+}
+
+.site-footer__group h2 {
+  font-size: 0.8rem;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  color: var(--text-faint);
+  margin-bottom: 16px;
+  font-weight: 600;
+}
+
+.site-footer__group ul {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.site-footer__group a {
+  color: var(--text-muted);
+  font-size: 0.92rem;
+  transition: color 0.15s ease;
+}
+
+.site-footer__group a:hover {
+  color: var(--amber);
+}
+
+.site-footer__legal {
+  border-top: 1px solid var(--border-soft);
+  padding: 20px 24px;
+}
+
+.site-footer__legal p {
+  max-width: var(--content-width);
+  margin: 0 auto;
+  color: var(--text-faint);
+  font-size: 0.82rem;
+}
+
+/* -------------------------------------------------------------- responsive */
+
+@media (max-width: 900px) {
+  .hero {
+    grid-template-columns: 1fr;
+    padding-top: 56px;
+    text-align: left;
+  }
+
+  .hero__visual {
+    order: -1;
+  }
+
+  .day-cycle__layout {
+    grid-template-columns: 1fr;
+  }
+
+  .day-cycle__options {
+    grid-row: auto;
+    flex-direction: row;
+    flex-wrap: wrap;
+  }
+
+  .day-cycle__option {
+    flex: 1 1 calc(50% - 6px);
+  }
+
+  .features__grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .specs__grid {
+    grid-template-columns: 1fr;
+    padding: 24px;
+  }
+
+  .social-proof__grid {
+    grid-template-columns: 1fr;
+  }
+
+  .pricing__grid {
+    grid-template-columns: 1fr;
+  }
+
+  .pricing-card--featured {
+    transform: none;
+  }
+
+  .site-footer__inner {
+    grid-template-columns: 1fr;
+  }
+
+  .primary-nav {
+    display: none;
+  }
+}
+
+@media (max-width: 560px) {
+  .site-header__inner {
+    padding: 14px 16px;
+  }
+
+  #hero,
+  .hero,
+  #day-cycle,
+  #features,
+  #specs,
+  #social-proof,
+  #pricing,
+  #faq {
+    padding-left: 18px;
+    padding-right: 18px;
+  }
+
+  .hero {
+    padding-top: 44px;
+    padding-bottom: 56px;
+  }
+
+  .hero__stats {
+    gap: 24px;
+  }
+
+  .features__grid {
+    grid-template-columns: 1fr;
+  }
+
+  .day-cycle__option {
+    flex: 1 1 100%;
+  }
+
+  .site-footer__nav {
+    grid-template-columns: 1fr 1fr;
+  }
+
+  .pricing-card--featured {
+    transform: none;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.001ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.001ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+html {
+  scroll-behavior: smooth;
 }
