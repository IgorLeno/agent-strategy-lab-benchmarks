+  beginner: 'Beginner',
+  intermediate: 'Intermediate',
+  expert: 'Expert',
+};
+
+const STATUS_LABELS: Record<GameStatus, string> = {
+  playing: 'Playing',
+  won: 'Won',
+  lost: 'Lost',
+};
+
+const STATUS_EMOJI: Record<GameStatus, string> = {
+  playing: '\u{1F642}',
+  won: '\u{1F60E}',
+  lost: '\u{1F635}',
+};
+
 export default function App() {
