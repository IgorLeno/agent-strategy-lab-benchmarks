{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IgorLeno/agent-strategy-lab-benchmarks/schemas/experiment-result.schema.json",
  "title": "Agent Strategy Lab experiment result",
  "description": "Machine-readable record of one completed experiment. A benchmark definition lives under benchmarks/; this schema describes experiments/<id>/experiment.json. UNKNOWN is never coerced to zero.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "benchmark_id",
    "status",
    "agent_lab_baseline",
    "excluded_agent_lab_commit",
    "model",
    "reasoning_effort",
    "direct_profile",
    "agentlab_profile",
    "seed_sha",
    "task_sha256",
    "arm_order",
    "validity"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^B[0-9]{2}-[a-z0-9-]+$"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "ABORTED",
        "INVALID",
        "BLOCKED"
      ]
    },
    "agent_lab_baseline": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "excluded_agent_lab_commit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "type": "string",
      "minLength": 1
    },
    "direct_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentlab_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arm_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "DIRECT",
          "AGENTLAB"
        ]
      }
    },
    "validity": {
      "enum": [
        "VALID",
        "VALID_WITH_MODEL_PURITY_WARNING",
        "INVALID",
        "UNKNOWN"
      ]
    },
    "warning": {
      "type": "string"
    },
    "winner": {
      "enum": [
        "DIRECT",
        "AGENTLAB",
        "TIE",
        "NONE",
        "UNKNOWN"
      ]
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "code_quality": {
          "description": "Numeric score or NOT_EVALUATED. UNKNOWN/NOT_EVALUATED must never be stored as 0.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "NOT_EVALUATED",
                "UNKNOWN"
              ]
            },
            {
              "type": "number"
            },
            {
              "type": "object"
            }
          ]
        }
      }
    }
  }
}
