{
  "name": "bridge-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/api",
    "packages/client",
    "apps/cli"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b --pretty false",
    "test": "node --test packages/core/dist/*.test.js packages/api/dist/*.test.js packages/client/dist/*.test.js apps/cli/dist/*.test.js",
    "check": "node validation/check.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.10.5"
  },
  "engines": {
    "node": ">=22"
  }
}
