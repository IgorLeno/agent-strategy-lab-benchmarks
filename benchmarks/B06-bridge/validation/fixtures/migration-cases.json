{
  "schema_version": 1,
  "description": "Frozen migration contract. 'expected' is the exact document migrateToV2 must produce, and the exact object the canonical serializer must emit.",
  "cases": [
    {
      "id": "full-v1",
      "input": {
        "version": 1,
        "name": "nightly",
        "timeout": 30,
        "retries": 3,
        "concurrency": 4,
        "notify": [
          "ops@example.com",
          "oncall@example.com"
        ],
        "cache": true,
        "env": {
          "TZ": "UTC",
          "LANG": "C"
        }
      },
      "expected": {
        "version": 2,
        "name": "nightly",
        "execution": {
          "timeout_seconds": 30,
          "concurrency": 4,
          "retry": {
            "max_attempts": 3,
            "backoff": "exponential"
          }
        },
        "delivery": {
          "notify": [
            "ops@example.com",
            "oncall@example.com"
          ]
        },
        "cache": {
          "enabled": true,
          "ttl_seconds": 300
        },
        "env": {
          "LANG": "C",
          "TZ": "UTC"
        },
        "extensions": {}
      }
    },
